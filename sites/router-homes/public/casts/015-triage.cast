{"version": 2, "width": 100, "height": 35, "timestamp": 1792558768, "idle_time_limit": 1.5, "env": {"SHELL": "/bin/bash", "TERM": "dumb"}, "title": "015 network triage on OpenWrt 25.12.6"}
[0.00227, "o", "\u001b[1;34m# 015 lab: universal vs terminal vs DNS vs WAN failure (OpenWrt 25.12.6)\u001b[0m\r\n\u001b[1;34m## baseline\u001b[0m\r\n\u001b[1;32m$ ubus call network.interface.wan status | grep -E \"\\\"up\\\"|address|nexthop\" | head -8\u001b[0m\r\n"]
[4.596729, "o", "\t\"up\": true,\r\n\t\t\"addresses\",\r\n\t\"ipv4-address\": [\r\n\t\t\t\"address\": \"192.168.50.191\",\r\n\t\"ipv6-address\": [\r\n\t\t\t\"nexthop\": \"192.168.50.1\",\r\n\t\t\"ipv4-address\": [\r\n\t\t\"ipv6-address\": [\r\n"]
[4.599842, "o", "\u001b[1;32m$ [client] ping -c 2 -W 2 1.1.1.1\u001b[0m\r\n"]
[10.535119, "o", "PING 1.1.1.1 (1.1.1.1) 56(84) bytes of data.\r\n64 bytes from 1.1.1.1: icmp_seq=1 ttl=48 time=42.0 ms\r\n"]
[11.538003, "o", "64 bytes from 1.1.1.1: icmp_seq=2 ttl=48 time=42.6 ms\r\n\r\n--- 1.1.1.1 ping statistics ---\r\n2 packets transmitted, 2 received, 0% packet loss, time 1002ms\r\nrtt min/avg/max/mdev = 41.965/42.259/42.553/0.294 ms\r\n"]
[11.575361, "o", "\u001b[1;32m$ [client] nslookup openwrt.org 192.168.1.1 | tail -3\u001b[0m\r\n"]
[17.313197, "o", "Name:\topenwrt.org\r\nAddress: 2a03:b0c0:3:d0::1a51:c001\r\n\r\n"]
[17.315865, "o", "\u001b[1;34m## DNS server stopped: IP works, name resolution fails\u001b[0m\r\n\u001b[1;32m$ /etc/init.d/dnsmasq stop; echo stopped\u001b[0m\r\n"]
[22.581015, "o", "stopped\r\n"]
[22.582288, "o", "\u001b[1;32m$ ping -c 2 -W 2 1.1.1.1 | tail -2\u001b[0m\r\n"]
[27.867449, "o", "2 packets transmitted, 2 packets received, 0% packet loss\r\nround-trip min/avg/max = 42.050/42.298/42.547 ms\r\n"]
[27.867977, "o", "\u001b[1;32m$ nslookup openwrt.org 127.0.0.1\u001b[0m\r\n"]
[32.003437, "o", ";; connection timed out; no servers could be reached\r\n\r\nnslookup: write to '127.0.0.1': Connection refused\r\n"]
[32.005362, "o", "\u001b[1;32m$ [client] ping -c 2 -W 2 1.1.1.1 | tail -2\u001b[0m\r\n"]
[42.035226, "o", "2 packets transmitted, 1 received, 50% packet loss, time 1001ms\r\nrtt min/avg/max/mdev = 42.274/42.274/42.274/0.000 ms\r\n"]
[42.038278, "o", "\u001b[1;32m$ [client] nslookup openwrt.org 192.168.1.1\u001b[0m\r\n"]
[48.146269, "o", ";; communications error to 192.168.1.1#53: connection refused\r\n;; communications error to 192.168.1.1#53: connection refused\r\n;; communications error to 192.168.1.1#53: connection refused\r\n;; no servers could be reached\r\n\r\n"]
[48.147906, "o", "\u001b[1;34m## DNS restored\u001b[0m\r\n\u001b[1;32m$ /etc/init.d/dnsmasq start; sleep 2; nslookup openwrt.org 127.0.0.1 | tail -3\u001b[0m\r\n"]
[53.447745, "o", "udhcpc: started, v1.37.0\r\n"]
[53.480405, "o", "udhcpc: broadcasting discover\r\n"]
[56.56237, "o", "udhcpc: no lease, failing\r\n"]
[58.576441, "o", "Name:\topenwrt.org\r\nAddress: 2a03:b0c0:3:d0::1a51:c001\r\n\r\n"]
[58.578581, "o", "\u001b[1;34m## WAN down: LAN/gateway still works, public IP fails\u001b[0m\r\n"]
[58.579015, "o", "\u001b[1;32m$ ifdown wan; sleep 2; ip -4 addr show eth1 | grep inet || echo no-wan; ping -c 2 -W 2 1.1.1.1\u001b[0m\r\n"]
[64.789411, "o", "no-wan\r\nPING 1.1.1.1 (1.1.1.1): 56 data bytes\r\nping: sendto: Network unreachable\r\n"]
[64.790466, "o", "\u001b[1;32m$ [client] ping -c 2 -W 2 192.168.1.1 | tail -2\u001b[0m\r\n"]
[72.674307, "o", "2 packets transmitted, 2 received, 0% packet loss, time 1052ms\r\nrtt min/avg/max/mdev = 0.091/0.102/0.113/0.011 ms\r\n"]
[72.676612, "o", "\u001b[1;32m$ [client] ping -c 2 -W 2 1.1.1.1 | tail -2\u001b[0m\r\n"]
[80.814801, "o", "2 packets transmitted, 0 received, +2 errors, 100% packet loss, time 1035ms\r\n\r\n"]
[80.816254, "o", "\u001b[1;34m## WAN restored\u001b[0m\r\n\u001b[1;32m$ ifup wan; sleep 4; ping -c 2 -W 2 1.1.1.1 | tail -2\u001b[0m\r\n"]
[90.778696, "o", "2 packets transmitted, 2 packets received, 0% packet loss\r\nround-trip min/avg/max = 42.219/42.478/42.737 ms\r\n"]
[90.779333, "o", "\u001b[1;34m## client default route removed: one terminal only\u001b[0m\r\n"]
[90.779343, "o", "\u001b[1;32m$ [client] ip route del default; ip route\u001b[0m\r\n"]
[97.838121, "o", "192.168.1.0/24 dev veth-client proto kernel scope link src 192.168.1.175 \r\n"]
[97.839158, "o", "\u001b[1;32m$ [client] ping -c 2 -W 2 192.168.1.1 | tail -2\u001b[0m\r\n"]
[103.828293, "o", "2 packets transmitted, 2 received, 0% packet loss, time 1058ms\r\nrtt min/avg/max/mdev = 0.136/0.149/0.163/0.013 ms\r\n"]
[103.8606, "o", "\u001b[1;32m$ [client] ping -c 2 -W 2 1.1.1.1 | tail -2\u001b[0m\r\n"]
[109.809853, "o", "ping: connect"]
[109.810569, "o", ": Network is unreachable\r\n"]
[109.811643, "o", "\u001b[1;32m$ [client] ip route add default via 192.168.1.1; ping -c 2 -W 2 1.1.1.1 | tail -2\u001b[0m\r\n"]
[116.960225, "o", "2 packets transmitted, 2 received, 0% packet loss, time 1002ms\r\nrtt min/avg/max/mdev = 42.794/42.864/42.935/0.070 ms\r\n\u001b[1;34m# done\u001b[0m\r\n"]
