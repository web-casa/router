{"version": 2, "width": 100, "height": 30, "timestamp": 1792569074, "idle_time_limit": 1.5, "env": {"SHELL": "/bin/bash", "TERM": "dumb"}, "title": "009 bypass gateway on OpenWrt 25.12.6"}
[0.002118, "o", "\u001b[1;34m# 009 lab: bypass gateway, DHCP off, static gateway/DNS (OpenWrt 25.12.6)\u001b[0m\r\n\u001b[1;34m## bypass LAN .2, DHCP disabled, WAN up\u001b[0m\r\n\u001b[1;32m$ [router] uci show network.lan | grep -E \"ipaddr|device\"; uci show dhcp.lan | grep ignore; ubus call network.interface.wan status | grep -E \"\\\\\\\"up\\\\\\\"|address\" | head -4\u001b[0m\r\n"]
[4.7774, "o", "network.lan.device='br-lan'\r\nnetwork.lan.ipaddr='192.168.1.2/24'\r\ndhcp.lan.ignore='1'\r\n\t\"up\": true,\r\n\t\t\"addresses\",\r\n\t\"ipv4-address\": [\r\n\t\t\t\"address\": \"192.168.50.5\",\r\n"]
[4.778336, "o", "\u001b[1;34m## static client: 192.168.1.100/24, gateway/DNS .2\u001b[0m\r\n\u001b[1;32m$ [client] ip -4 addr show veth-client | grep inet; ip route\u001b[0m\r\n"]
[10.93825, "o", "    inet 192.168.1.100/24 scope global veth-client\r\ndefault via 192.168.1.2 dev veth-client \r\n192.168.1.0/24 dev veth-client proto kernel scope link src 192.168.1.100 \r\n"]
[10.939299, "o", "\u001b[1;32m$ [client] ping -c 2 -W 2 192.168.1.2 | tail -2\u001b[0m\r\n"]
[17.714214, "o", "2 packets transmitted, 2 received, 0% packet loss, time 1060ms\r\nrtt min/avg/max/mdev = 0.119/0.133/0.147/0.014 ms\r\n"]
[17.749785, "o", "\u001b[1;32m$ [client] ping -c 2 -W 2 1.1.1.1 | tail -2\u001b[0m\r\n"]
[27.109199, "o", "2 packets transmitted, 2 received, 0% packet loss, time 1001ms\r\nrtt min/avg/max/mdev = 41.871/42.334/42.798/0.463 ms\r\n"]
[27.111678, "o", "\u001b[1;32m$ [client] nslookup openwrt.org 192.168.1.2 | tail -3\u001b[0m\r\n"]
[36.486872, "o", "Name:\topenwrt.org\r\nAddress: 2a03:b0c0:3:d0::1a51:c001\r\n\r\n"]
[36.489578, "o", "\u001b[1;34m## DNS switched to public 1.1.1.1\u001b[0m\r\n"]
[36.4899, "o", "\u001b[1;32m$ [client] nslookup openwrt.org 1.1.1.1 | tail -3\u001b[0m\r\n"]
[42.613043, "o", "Name:\topenwrt.org\r\nAddress: 2a03:b0c0:3:d0::1a51:c001\r\n\r\n"]
[42.615254, "o", "\u001b[1;34m## dead gateway .250: public fails; restore .2\u001b[0m\r\n\u001b[1;32m$ [client] ip route del default; ip route add default via 192.168.1.250; ping -c 2 -W 2 1.1.1.1 | tail -2\u001b[0m\r\n"]
[53.170642, "o", "2 packets transmitted, 0 received, 100% packet loss, time 1030ms\r\n\r\n"]
[53.198309, "o", "\u001b[1;32m$ [client] ip route del default; ip route add default via 192.168.1.2; ping -c 2 -W 2 1.1.1.1 | tail -2\u001b[0m\r\n"]
[62.201989, "o", "2 packets transmitted, 2 received, 0% packet loss, time 1001ms\r\nrtt min/avg/max/mdev = 41.903/41.950/41.998/0.047 ms\r\n"]
[62.203749, "o", "\u001b[1;34m## DHCP request after switching: no offer (expected)\u001b[0m\r\n\u001b[1;32m$ [client] /usr/bin/busybox udhcpc -i veth-client -f -q -n -t 3 2>&1\u001b[0m\r\n"]
[71.386732, "o", "udhcpc: started, v1.37.0\r\nudhcpc: broadcasting discover\r\n"]
[74.379444, "o", "udhcpc: broadcasting discover\r\n"]
[77.396558, "o", "udhcpc: broadcasting discover\r\n"]
[80.419007, "o", "udhcpc: no lease, failing\r\n"]
[80.451489, "o", "\u001b[1;34m# done\u001b[0m\r\n"]
