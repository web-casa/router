{"version": 2, "width": 100, "height": 30, "timestamp": 1792572236, "idle_time_limit": 1.5, "env": {"SHELL": "/bin/bash", "TERM": "dumb"}, "title": "008 wired AP on OpenWrt 25.12.6"}
[0.003845, "o", "\u001b[1;34m# 008 lab: wired AP, DHCP off, client leases from upstream (OpenWrt 25.12.6)\u001b[0m\r\n\u001b[1;34m## AP LAN .2, DHCP disabled\u001b[0m\r\n\u001b[1;32m$ [AP] uci show network.lan | grep -E \"device|ipaddr\"; uci show dhcp.lan | grep ignore; ip -4 addr show br-lan | grep inet\u001b[0m\r\n"]
[5.469245, "o", "network.lan.device='br-lan'\r\nnetwork.lan.ipaddr='192.168.1.2/24'\r\n"]
[5.469586, "o", "dhcp.lan.ignore='1'\r\n    inet 192.168.1.2/24 brd 192.168.1.255 scope global br-lan\r\n"]
[5.470657, "o", "\u001b[1;34m## client leases from upstream 192.168.1.1 (not AP)\u001b[0m\r\n"]
[5.47071, "o", "\u001b[1;32m$ [client] /usr/bin/busybox udhcpc -i veth-client -s /tmp/udhcpc-ap.sh -f -q -n -t 8 2>&1\u001b[0m\r\n"]
[10.716007, "o", "udhcpc: started, v1.37.0\r\nudhcpc: broadcasting discover\r\n"]
[10.747671, "o", "udhcpc: broadcasting select for 192.168.1.136, server 192.168.1.1\r\nudhcpc: lease of 192.168.1.136 obtained from 192.168.1.1, lease time 864000\r\n"]
[10.749989, "o", "\u001b[1;32m$ [client] ip -4 addr show veth-client | grep inet; ip route\u001b[0m\r\n"]
[21.124163, "o", "    inet 192.168.1.136/24 scope global veth-client\r\ndefault via 192.168.1.1 dev veth-client \r\n192.168.1.0/24 dev veth-client proto kernel scope link src 192.168.1.136 \r\n"]
[21.1262, "o", "\u001b[1;34m## AP management and upstream reachability\u001b[0m\r\n"]
[21.126334, "o", "\u001b[1;32m$ [client] ping -c 2 -W 2 192.168.1.2 | tail -2\u001b[0m\r\n"]
[31.712594, "o", "2 packets transmitted, 2 received, 0% packet loss, time 1064ms\r\nrtt min/avg/max/mdev = 0.093/0.131/0.169/0.038 ms\r\n"]
[31.713679, "o", "\u001b[1;32m$ [client] ping -c 2 -W 2 192.168.1.1 | tail -2\u001b[0m\r\n"]
[38.109315, "o", "2 packets transmitted, 2 received, 0% packet loss, time 1052ms\r\nrtt min/avg/max/mdev = 0.023/0.034/0.046/0.011 ms\r\n"]
[38.110283, "o", "\u001b[1;34m## no internet in this AP-only lab (expected)\u001b[0m\r\n\u001b[1;32m$ [client] ping -c 2 -W 2 1.1.1.1 | tail -2\u001b[0m\r\n"]
[46.06612, "o", "2 packets transmitted, 0 received, 100% packet loss, time 1033ms\r\n\r\n"]
[46.068809, "o", "\u001b[1;34m# done\u001b[0m\r\n"]
