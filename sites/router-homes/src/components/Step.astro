---
import Icon from './Icon.astro';

interface Props {
  where: 'router-shell' | 'luci' | 'client' | 'phone' | 'console' | 'pve' | string;
  title?: string;
  expected?: string;
}
const locale = (Astro.locals as any).starlightRoute?.locale ?? 'en';
const isEn = locale === 'en';
const labels: Record<string, string> = isEn
  ? { 'router-shell': 'Router shell', luci: 'LuCI', client: 'Computer', phone: 'Phone', console: 'Console', pve: 'PVE host' }
  : { 'router-shell': '路由器 Shell', luci: 'LuCI', client: '电脑', phone: '手机', console: '本地控制台', pve: 'PVE 宿主机' };
// Solar icon per execution location.
const icons: Record<string, string> = {
  'router-shell': 'code-square',
  luci: 'window-frame',
  client: 'laptop-minimalistic',
  phone: 'smartphone',
  console: 'keyboard',
  pve: 'server-square',
};
const { where, title, expected } = Astro.props;
const label = labels[where] ?? where;
const icon = icons[where] ?? icons['router-shell'];
---
<div class="step" data-where={where}>
  <div class="step-main">
    <div class="step-head">
      <span class="step-badge"><Icon name={icon} />{label}</span>
      {title && <strong>{title}</strong>}
    </div>
    <div class="step-body"><slot /></div>
    {expected && <p class="step-expected"><span class="step-expected-label">{isEn ? 'Expected' : '预期'}</span><span>{expected}</span></p>}
  </div>
</div>
