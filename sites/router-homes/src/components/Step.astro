---
interface Props {
  where: 'router-shell' | 'luci' | 'client' | 'phone' | string;
  title?: string;
  expected?: string;
}
const locale = (Astro.locals as any).starlightRoute?.locale ?? 'en';
const isEn = locale === 'en';
const labels: Record<string, string> = isEn
  ? { 'router-shell': 'Router shell', luci: 'LuCI', client: 'Computer', phone: 'Phone', console: 'Console' }
  : { 'router-shell': '路由器 Shell', luci: 'LuCI', client: '电脑', phone: '手机', console: '本地控制台' };
const { where, title, expected } = Astro.props;
const label = labels[where] ?? where;
---
<div class="step">
  <div class="step-head">
    <span class="step-badge">{label}</span>
    {title && <strong>{title}</strong>}
  </div>
  <div class="step-body"><slot /></div>
  {expected && <p class="step-expected">{isEn ? 'Expected' : '预期'}：{expected}</p>}
</div>
