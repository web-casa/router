// Headings may mark preferred break points with '|' (see Home.astro).
const phrases = (text: string) => text.split('|').map((p) => `<span class="rh-phrase">${p}</span>`).join('');

const arrow =
  '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>';
const ext =
  '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.5h6.5V10M12.5 3.5 4 12"/></svg>';
const pathIcons = ['wi-fi-router', 'refresh-circle', 'server-square'];
const typeIcons = ['box', 'refresh-circle', 'ssd-square', 'ssd-round', 'folder', 'sd-card'];
const groupIcons: Record<string, string> = { wifi6: 'wi-fi-router', wifi5: 'wi-fi-router-minimalistic', travel: 'suitcase', board: 'cpu', x86: 'server-square' };
const counts = Object.fromEntries(groups.map((g) => [g.id, devices.filter((d) => d.group === g.id).length]));
---

<div class="rh-home dl not-content">
  <!-- 01 · paths -->
  <section class="rh-section" aria-labelledby="dl-paths">
    <div class="rh-section-head rh-reveal">
      <p class="rh-kicker"><span>01</span>{t.pathKicker}</p>
      <h2 id="dl-paths" set:html={phrases(t.pathTitle)} />
    </div>
    <ol class="dl-paths">
      {t.paths.map((p, i) => (
        <li class="rh-reveal">
          <a class="dl-path rh-spot" href={p.anchor ?? p.href}>
            <span class="dl-path-tag"><span class="dl-path-n"><Icon name={pathIcons[i]} /></span>{p.tag}</span>
            <h3>{p.title}</h3>
            <ol class="dl-path-steps">
              {p.steps.map((s) => <li>{s}</li>)}
            </ol>
            <span class="dl-path-cta">{p.cta}<Fragment set:html={arrow} /></span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- 02 · three checks -->
  <section class="rh-section" aria-labelledby="dl-steps">
    <div class="rh-section-head rh-reveal">
      <p class="rh-kicker"><span>02</span>{t.stepsKicker}</p>
      <h2 id="dl-steps" set:html={phrases(t.stepsTitle)} />
    </div>
    <ol class="dl-steps">
      {t.steps.map((s, i) => (
        <li class="dl-step rh-reveal">
          <div class="dl-step-head">
            <span class="dl-step-n">{s.n}</span>
            <h3>{s.title}</h3>
          </div>
          <p>{s.body}</p>
          {i === 0 && (
            <pre class="dl-code"><span class="c">root@OpenWrt:~# </span>ubus call system board
{'{'}
  <b>"model"</b>: "&lt;{pick(locale, { en: 'device model', zh: '设备型号', 'zh-hant': '裝置型號', ja: 'デバイスのモデル名', es: 'modelo del dispositivo', de: 'Gerätemodell', fr: 'modèle de l’appareil' })}&gt;",
  <b>"board_name"</b>: "&lt;{pick(locale, { en: 'board id', zh: '板子 ID', 'zh-hant': '板子 ID', ja: 'ボード ID', es: 'ID de la placa', de: 'Board-ID', fr: 'ID de la carte' })}&gt;",
  "release": {'{'}
    <b>"distribution"</b>: "OpenWrt",
    <b>"version"</b>: "{RELEASE}",
    <b>"target"</b>: "x86/64"
  {'}'}
{'}'}</pre>
          )}
          {i === 1 && (
            <ul class="dl-traps">
              {t.traps.map(([name, detail]) => (
                <li><strong>{name}</strong><span>{detail}</span></li>
              ))}
            </ul>
          )}
          {i === 2 && (
            <div class="dl-os">
              {['Linux', 'macOS', 'Windows'].map((os, k) => (
                <label><input type="radio" name="dl-os" value={os} checked={k === 0} /><span>{os}</span></label>
              ))}
              <pre class="dl-code dl-os-linux"><span class="c">$ </span>sha256sum openwrt-*.img.gz</pre>
              <pre class="dl-code dl-os-macos"><span class="c">$ </span>shasum -a 256 openwrt-*.img.gz</pre>
              <pre class="dl-code dl-os-windows"><span class="c">&gt; </span>certutil -hashfile openwrt-*.img.gz SHA256</pre>
            </div>
          )}
          <a class="dl-more" href={s.href}>{s.cta}<Fragment set:html={arrow} /></a>
        </li>
      ))}
    </ol>
  </section>

  <!-- 03 · image types -->
  <section class="rh-section" aria-labelledby="dl-types">
    <div class="rh-section-head rh-reveal">
      <p class="rh-kicker"><span>03</span>{t.typesKicker}</p>
      <h2 id="dl-types" set:html={phrases(t.typesTitle)} />
    </div>
    <ul class="dl-types">
      {t.types.map(([name, use, avoid], i) => (
        <li class="rh-reveal">
          <div class="dl-type-head"><Icon name={typeIcons[i]} /><code>{name}</code></div>
          <p><span class="ok">{t.use}</span>{use}</p>
          <p><span class="no">{t.avoid}</span>{avoid}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- 04 · x86 picker -->
  <section class="rh-section" id="x86" aria-labelledby="dl-x86">
    <div class="rh-section-head rh-reveal">
      <p class="rh-kicker"><span>04</span>{t.x86Kicker}</p>
      <h2 id="dl-x86" set:html={phrases(t.x86Title)} />
    </div>
    <div class="dl-x86 rh-reveal">
      <fieldset>
        <legend>{t.boot}</legend>
        <label><input type="radio" name="dl-boot" value="bios" checked /><span>{t.bios}</span></label>
        <label><input type="radio" name="dl-boot" value="uefi" /><span>{t.uefi}</span></label>
      </fieldset>
      <fieldset>
        <legend>{t.fsq}</legend>
        <label><input type="radio" name="dl-fs" value="ext4" checked /><span>{t.ext4}</span></label>
        <label><input type="radio" name="dl-fs" value="squashfs" /><span>{t.squash}</span></label>
      </fieldset>
      <div class="dl-x86-out" aria-live="polite">
        {['ext4', 'squashfs'].flatMap((fs) =>
          [false, true].map((efi) => (
            <div class:list={['dl-x86-result', `r-${fs}-${efi ? 'uefi' : 'bios'}`]}>
              <code class="dl-x86-file">{x86File(fs, efi)}</code>
              <p class:list={['dl-x86-badge', { tested: fs === 'ext4' && !efi }]}>
                <span class="rh-led" data-state={fs === 'ext4' && !efi ? 'ok' : undefined} />
                {fs === 'ext4' && !efi ? t.tested : t.untested}
              </p>
              <div class="dl-x86-links">
                <a class="rh-pill" href={x86Base + x86File(fs, efi)}><span>{t.getIt}</span><Fragment set:html={arrow} /></a>
                <a class="rh-text-link" href={x86Base + 'sha256sums'}>{t.sums}</a>
              </div>
            </div>
          ))
        )}
        <a class="dl-more" href={L('getting-started/x86-image')}>{t.x86More}<Fragment set:html={arrow} /></a>
      </div>
    </div>
  </section>

  <!-- 05 · devices -->
  <section class="rh-section" id="devices" aria-labelledby="dl-devices">
    <div class="rh-section-head rh-reveal">
      <p class="rh-kicker"><span>05</span>{t.devKicker}</p>
      <h2 id="dl-devices" set:html={phrases(t.devTitle)} />
      <p class="rh-lede">{t.devNote}</p>
    </div>
    <div class="dl-dev">
      <div class="dl-filter" role="radiogroup" aria-label={t.devKicker}>
        <label><input type="radio" name="dl-group" value="all" checked /><span>{t.all}<em>{devices.length}</em></span></label>
        {groups.map((g) => (
          <label><input type="radio" name="dl-group" value={g.id} /><span><Icon name={groupIcons[g.id]} />{pick(locale, { en: g.en, zh: g.zh, 'zh-hant': g['zh-hant'], ja: g.ja, es: g.es, de: g.de, fr: g.fr })}<em>{counts[g.id]}</em></span></label>
        ))}
      </div>
      <ul class="dl-devices">
        {devices.map((d) => (
          <li class="dl-device" data-group={d.group}>
            <div class="dl-device-top">
              <span class:list={['dl-wifi', `w-${d.wifi.replace(/\W/g, '').toLowerCase()}`]}>{t.wifi[d.wifi]}</span>
              <code>{d.target}</code>
            </div>
            <h3><Icon name={groupIcons[d.group]} />{d.name}</h3>
            {d.variants && <p class="dl-variants">{pick(locale, { en: d.variants.en, zh: d.variants.zh, 'zh-hant': d.variants['zh-hant'], ja: d.variants.ja, es: d.variants.es, de: d.variants.de, fr: d.variants.fr })}</p>}
            <div class="dl-device-links">
              <a href={selectorUrl(d)}>{t.selector}<Fragment set:html={ext} /></a>
              <a href={targetUrl(d.target)}>{t.folder}<Fragment set:html={ext} /></a>
            </div>
          </li>
        ))}
      </ul>
      <p class="dl-notlisted"><a href="https://firmware-selector.openwrt.org/">{t.notListed}<Fragment set:html={ext} /></a></p>
    </div>
  </section>

  <!-- 06 · checklist -->
  <section class="rh-section rh-close dl-check rh-reveal" aria-labelledby="dl-check">
    <p class="rh-kicker"><span>06</span>{t.checkKicker}</p>
    <h2 id="dl-check" set:html={phrases(t.checkTitle)} />
    <ul class="dl-checks">
      {t.checks.map((c) => (
        <li><label><input type="checkbox" /><span class="box" aria-hidden="true" /><span>{c}</span></label></li>
      ))}
    </ul>
    <p class="dl-ready"><span class="rh-led" data-state="ok" /><span>{t.ready}</span></p>
    <p class="dl-notready"><span class="rh-led" /><span>{t.notReady}</span></p>
  </section>
</div>

<script>
  // Cursor-following highlight on the path cards (fine pointers only).
  if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
    for (const card of document.querySelectorAll<HTMLElement>('.dl-path')) {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - r.left}px`);
        card.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    }
  }
</script>

