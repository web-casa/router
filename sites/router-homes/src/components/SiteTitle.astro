---
const { siteTitleHref } = (Astro.locals as any).starlightRoute;
---

<a href={siteTitleHref} class="site-title rh-brand" aria-label="Router.Homes">
  <svg class="rh-mark" viewBox="0 0 28 28" fill="none" aria-hidden="true">
    <path d="M4 12.6 14 4l10 8.6V22a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-9.4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
    <rect x="9" y="15" width="10" height="5" rx="1.2" stroke="currentColor" stroke-width="1.6" />
    <circle class="rh-mark-led" cx="16.3" cy="17.5" r="1.25" />
    <circle cx="11.8" cy="17.5" r="1.1" fill="currentColor" opacity=".45" />
  </svg>
  <span class="rh-word" translate="no">Router<span>.Homes</span></span>
</a>

<style>
  .rh-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
  }
  .rh-mark {
    width: 1.65rem;
    height: 1.65rem;
    flex: none;
    transition: transform 0.5s var(--rh-ease-spring);
  }
  .rh-brand:hover .rh-mark {
    transform: translateY(-2px) rotate(-4deg);
  }
  .rh-mark-led {
    fill: var(--sl-color-accent);
    filter: drop-shadow(0 0 3px var(--sl-color-accent));
  }
  @media (prefers-reduced-motion: no-preference) {
    .rh-mark-led {
      animation: rh-mark-blink 4.8s steps(1, end) infinite;
    }
  }
  @keyframes rh-mark-blink {
    0%, 100% { opacity: 1; }
    88% { opacity: 1; }
    90% { opacity: 0.2; }
    92% { opacity: 1; }
    94% { opacity: 0.3; }
    96% { opacity: 1; }
  }
  .rh-word {
    font-size: 1.08rem;
    font-weight: 680;
    letter-spacing: -0.035em;
    overflow: hidden;
  }
  .rh-word span {
    font-weight: 420;
    color: var(--sl-color-gray-3);
    transition: color 0.3s;
  }
  .rh-brand:hover .rh-word span {
    color: var(--sl-color-accent);
  }
</style>
