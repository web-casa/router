---
import 'asciinema-player/dist/bundle/asciinema-player.css';
import { pick } from '../i18n';

interface Props {
  src: string;
  title: string;
  caption?: string;
}

const { src, title, caption } = Astro.props;
const locale = (Astro.locals as any).starlightRoute?.locale ?? 'en';
---

<figure class="terminal-cast">
  <div class="terminal-cast-head">
    <span class="terminal-cast-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="terminal-cast-title">{title}</span>
    <a href={src} download class="terminal-cast-download">{pick(locale, { en: 'Download .cast', zh: '下载 cast', 'zh-hant': '下載 cast', ja: '.cast をダウンロード', es: 'Descargar cast', de: 'cast herunterladen', fr: 'Télécharger le cast' })}</a>
  </div>
  <div
    class="terminal-cast-player"
    data-cast-src={src}
    data-cast-title={title}
    aria-label={title}
  ></div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  import { create } from 'asciinema-player';

  for (const el of document.querySelectorAll<HTMLElement>('[data-cast-src]')) {
    if (el.dataset.castReady === 'true') continue;
    el.dataset.castReady = 'true';
    create(el.dataset.castSrc || '', el, {
      autoPlay: false,
      preload: true,
      fit: 'width',
      controls: true,
      terminalFontSize: 'small',
      theme: 'asciinema',
    });
  }
</script>

<style>
  .terminal-cast {
    margin: 1.5rem 0;
    border: 1px solid var(--rh-line);
    border-radius: var(--rh-radius-lg);
    overflow: hidden;
    background: hsl(30, 8%, 7%);
    box-shadow: var(--rh-shadow);
  }

  .terminal-cast-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid hsl(30, 6%, 16%);
    color: hsl(33, 8%, 74%);
    font-size: var(--sl-text-sm);
  }

  .terminal-cast-dots {
    display: inline-flex;
    gap: 0.35rem;
  }

  .terminal-cast-dots i {
    margin: 0;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: hsl(30, 6%, 26%);
  }

  .terminal-cast-title {
    margin-top: 0;
    margin-inline-end: auto;
    font-family: var(--__sl-font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: hsl(36, 12%, 80%);
  }

  .terminal-cast-download {
    margin-top: 0;
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
    color: hsl(33, 8%, 74%);
    text-decoration: none;
    white-space: nowrap;
  }

  .terminal-cast-download:hover {
    color: hsl(38, 100%, 79%);
    text-decoration: underline;
  }

  .terminal-cast-player {
    min-height: 8rem;
  }

  .terminal-cast figcaption {
    padding: 0.65rem 0.85rem;
    border-top: 1px solid var(--rh-line);
    color: var(--sl-color-gray-2);
    background: var(--rh-surface);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }

  .terminal-cast :global(.ap-player) {
    border-radius: 0;
  }
</style>
