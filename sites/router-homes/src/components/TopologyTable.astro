---
import { pick } from '../i18n';
interface Row {
  physical: string;
  bridge: string;
  vnic: string;
  iface: string;
  role: string;
}
interface Props { rows: Row[] }
const { rows } = Astro.props;
const locale = (Astro.locals as any).starlightRoute?.locale ?? 'en';
const head = pick(locale, {
  en: ['Physical port', 'PVE bridge', 'Virtual NIC', 'OpenWrt interface', 'Role'],
  zh: ['物理口', 'PVE bridge', '虚拟网卡', 'OpenWrt 接口', '职责'],
  'zh-hant': ['實體連接埠', 'PVE bridge', '虛擬網路卡', 'OpenWrt 介面', '職責'],
  ja: ['物理ポート', 'PVE ブリッジ', '仮想 NIC', 'OpenWrt インターフェース', '役割'],
  es: ['Puerto físico', 'Bridge de PVE', 'NIC virtual', 'Interfaz de OpenWrt', 'Función'],
  de: ['Physischer Port', 'PVE-Bridge', 'Virtuelle NIC', 'OpenWrt-Schnittstelle', 'Aufgabe'],
  fr: ['Port physique', 'Bridge PVE', 'Carte réseau virtuelle', 'Interface OpenWrt', 'Rôle'],
});
---
<table class="topology">
  <thead>
    <tr>{head.map((cell) => <th>{cell}</th>)}</tr>
  </thead>
  <tbody>
    {rows.map((row) => (
      <tr><td>{row.physical}</td><td>{row.bridge}</td><td>{row.vnic}</td><td>{row.iface}</td><td>{row.role}</td></tr>
    ))}
  </tbody>
</table>
