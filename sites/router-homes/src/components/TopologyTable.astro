---
interface Row {
  physical: string;
  bridge: string;
  vnic: string;
  iface: string;
  role: string;
}
interface Props { rows: Row[] }
const { rows } = Astro.props;
const isEn = ((Astro.locals as any).starlightRoute?.locale ?? 'en') === 'en';
const head = isEn
  ? ['Physical port', 'PVE bridge', 'Virtual NIC', 'OpenWrt interface', 'Role']
  : ['物理口', 'PVE bridge', '虚拟网卡', 'OpenWrt 接口', '职责'];
---
<table class="topology">
  <thead>
    <tr>{head.map((cell) => <th>{cell}</th>)}</tr>
  </thead>
  <tbody>
    {rows.map((row) => (
      <tr><td>{row.physical}</td><td>{row.bridge}</td><td>{row.vnic}</td><td>{row.iface}</td><td>{row.role}</td></tr>
    ))}
  </tbody>
</table>
