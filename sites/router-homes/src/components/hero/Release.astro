---
// Variant "release": editorial type. A giant outlined release number fills
// with amber on load; two rows of real guide links drift underneath.
import HeroCopy from './HeroCopy.astro';
import HeroStats from './HeroStats.astro';
import type { HeroData } from './data';

interface Props { hero: HeroData }
const { hero } = Astro.props;
const major = hero.release.split('.').slice(0, 2).join('.');
const half = Math.ceil(hero.guides.length / 2);
const rows = [hero.guides.slice(0, half), hero.guides.slice(half)];
---

<section class="rh-hero rh-v-release" aria-labelledby="_top">
  <div class="rh-hero-grid" aria-hidden="true" />
  <p class="rh-release-num" aria-hidden="true">
    <span class="rh-release-outline">{major}</span>
    <span class="rh-release-fill">{major}</span>
  </p>
  <HeroCopy hero={hero} />

  <nav class="rh-marquee rh-in" style="--i:7" aria-label={hero.isEn ? 'Guides' : '文档'}>
    {rows.map((row, r) => (
      <div class:list={['rh-marquee-row', { 'rh-marquee-rev': r === 1 }]}>
        <ul class="rh-marquee-track">
          {[0, 1].map((copy) =>
            row.map((g) => (
              <li aria-hidden={copy === 1 ? 'true' : undefined}>
                <a href={g.href} tabindex={copy === 1 ? -1 : undefined}>{g.label}</a>
              </li>
            ))
          )}
        </ul>
      </div>
    ))}
  </nav>

  <HeroStats hero={hero} />
</section>

<style>
  .rh-v-release {
    position: relative;
    min-height: min(46rem, 88svh);
    align-content: end;
    padding-top: clamp(8rem, 22vw, 16rem);
  }
  .rh-v-release :global(.rh-hero-copy) {
    position: relative;
    z-index: 1;
    max-width: 44rem;
  }

  .rh-release-num {
    position: absolute;
    z-index: 0;
    top: clamp(0.5rem, 2vw, 2rem);
    inset-inline-end: clamp(-6rem, -4vw, -1rem);
    margin: 0;
    font-size: clamp(9rem, 4rem + 22vw, 26rem);
    font-weight: 720;
    line-height: 0.82;
    letter-spacing: -0.065em;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
    user-select: none;
  }
  .rh-release-num span {
    display: block;
  }
  /* A ghost fill rather than text-stroke: variable fonts have overlapping
     contours, and a stroke shows every seam. */
  .rh-release-outline {
    color: color-mix(in srgb, var(--sl-color-white) 4%, transparent);
  }
  .rh-release-fill {
    position: absolute;
    inset: 0;
    color: transparent;
    background: linear-gradient(180deg, var(--sl-color-accent-high), var(--sl-color-accent) 55%, color-mix(in srgb, var(--sl-color-accent) 40%, transparent));
    -webkit-background-clip: text;
    background-clip: text;
    clip-path: inset(0 0 0 0);
    opacity: 0.9;
    -webkit-mask-image: linear-gradient(180deg, #000 30%, transparent 95%);
    mask-image: linear-gradient(180deg, #000 30%, transparent 95%);
  }

  .rh-marquee {
    display: grid;
    gap: 0.75rem;
    margin-inline: calc(50% - 50vw);
    padding-block: 0.5rem;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .rh-marquee-row {
    display: flex;
    overflow: hidden;
  }
  .rh-marquee-track {
    display: flex;
    flex: none;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rh-marquee-track a {
    display: inline-flex;
    align-items: center;
    height: 2.5rem;
    padding-inline: 1.1rem;
    border: 1px solid var(--rh-line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--rh-surface) 85%, transparent);
    color: var(--sl-color-gray-2);
    font-size: 0.92rem;
    white-space: nowrap;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s, background-color 0.2s;
  }
  .rh-marquee-track a:hover,
  .rh-marquee-track a:focus-visible {
    color: var(--sl-color-white);
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }

  @media (prefers-reduced-motion: no-preference) {
    .rh-release-fill {
      animation: rh-fill 1.8s var(--rh-ease-out) 0.35s both;
    }
    .rh-marquee-track {
      animation: rh-marquee 60s linear infinite;
    }
    .rh-marquee-rev .rh-marquee-track {
      animation-direction: reverse;
      animation-duration: 72s;
    }
    .rh-marquee:hover .rh-marquee-track,
    .rh-marquee:focus-within .rh-marquee-track {
      animation-play-state: paused;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rh-marquee-row {
      overflow-x: auto;
    }
  }

  @media (max-width: 40rem) {
    .rh-v-release {
      min-height: 0;
      padding-top: clamp(7rem, 34vw, 10rem);
    }
    .rh-release-num {
      inset-inline-end: 0;
      font-size: 24vw;
    }
  }

  @keyframes rh-fill {
    from { clip-path: inset(100% 0 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  @keyframes rh-marquee {
    to { transform: translateX(calc(-50% - 0.375rem)); }
  }
</style>
