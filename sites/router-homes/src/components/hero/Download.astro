---
// Hero for the download page: headline left, a firmware filename taken apart
// right. Hover or focus a segment to light up what it means. No JS.
import HeroCopy from './HeroCopy.astro';
import HeroStats from './HeroStats.astro';
import type { HeroData } from './data';
import { pick } from '../../i18n';
import { RELEASE, RELEASE_DATE, devices } from '../download/devices';

interface Props { hero: HeroData }
const { hero } = Astro.props;
const l = hero.locale;

type Seg = { k: string; text: string };
const examples: { id: string; label: string; segs: Seg[] }[] = [
  {
    id: 'router',
    label: pick(l, { en: 'Router', zh: '路由器', 'zh-hant': '路由器', ja: 'ルーター', es: 'Router', de: 'Router', fr: 'Routeur' }),
    segs: [
      { k: 'project', text: 'openwrt' },
      { k: 'version', text: RELEASE },
      { k: 'target', text: 'mediatek-filogic' },
      { k: 'profile', text: 'xiaomi_mi-router-ax3000t' },
      { k: 'fs', text: 'squashfs' },
      { k: 'type', text: 'sysupgrade' },
    ],
  },
  {
    id: 'x86',
    label: 'x86',
    segs: [
      { k: 'project', text: 'openwrt' },
      { k: 'version', text: RELEASE },
      { k: 'target', text: 'x86-64' },
      { k: 'profile', text: 'generic' },
      { k: 'fs', text: 'ext4' },
      { k: 'type', text: 'combined-efi' },
    ],
  },
];
const ext = { router: '.bin', x86: '.img.gz' } as Record<string, string>;

const legend: { k: string; name: string; text: string }[] = pick(l, {
  en: [
      { k: 'version', name: 'Release', text: `${RELEASE} is the current stable release.` },
      { k: 'target', name: 'Target', text: 'Set by the chip platform. It must match your device exactly.' },
      { k: 'profile', name: 'Profile', text: 'The exact model, and sometimes the flash layout.' },
      { k: 'fs', name: 'Filesystem', text: 'squashfs can reset to defaults; ext4 is fully writable.' },
      { k: 'type', name: 'Image type', text: 'sysupgrade upgrades an existing OpenWrt; combined is a whole-disk image, -efi for UEFI.' },
      { k: 'ext', name: 'Extension', text: '.bin / .itb are flashed as is; .img.gz is unpacked before writing to disk.' },
    ],
  zh: [
      { k: 'version', name: '版本', text: `${RELEASE} 是当前稳定版。` },
      { k: 'target', name: 'target', text: '由芯片平台决定，必须和设备完全一致。' },
      { k: 'profile', name: 'profile', text: '精确到型号，有时还区分分区布局。' },
      { k: 'fs', name: '文件系统', text: 'squashfs 可以恢复出厂；ext4 整体可写。' },
      { k: 'type', name: '镜像类型', text: 'sysupgrade 用于已装 OpenWrt 的升级；combined 是含引导的整盘镜像，-efi 用于 UEFI。' },
      { k: 'ext', name: '扩展名', text: '.bin/.itb 直接刷入；.img.gz 要先解压再写盘。' },
  ],
  ja: [
      { k: 'version', name: 'リリース', text: `${RELEASE} は現在の安定版です。` },
      { k: 'target', name: 'Target', text: 'チップのプラットフォームで決まります。お使いのデバイスと完全に一致している必要があります。' },
      { k: 'profile', name: 'Profile', text: '正確なモデル名です。フラッシュのレイアウトまで区別する場合もあります。' },
      { k: 'fs', name: 'ファイルシステム', text: 'squashfs は初期設定に戻せます。ext4 は全体が書き込み可能です。' },
      { k: 'type', name: 'イメージの種類', text: 'sysupgrade は既存の OpenWrt のアップグレード用です。combined はディスク全体のイメージで、UEFI 用は -efi です。' },
      { k: 'ext', name: '拡張子', text: '.bin / .itb はそのままフラッシュします。.img.gz は展開してからディスクに書き込みます。' },
  ],
  es: [
      { k: 'version', name: 'Versión', text: `${RELEASE} es la versión estable actual.` },
      { k: 'target', name: 'Target', text: 'Lo fija la plataforma del chip. Debe coincidir exactamente con su dispositivo.' },
      { k: 'profile', name: 'Profile', text: 'El modelo exacto y, a veces, la distribución de la flash.' },
      { k: 'fs', name: 'Sistema de archivos', text: 'squashfs permite restablecer los valores por defecto; ext4 es totalmente escribible.' },
      { k: 'type', name: 'Tipo de imagen', text: 'sysupgrade actualiza un OpenWrt existente; combined es una imagen de disco completo, -efi para UEFI.' },
      { k: 'ext', name: 'Extensión', text: '.bin / .itb se flashean tal cual; .img.gz se descomprime antes de escribirla en disco.' },
  ],
  de: [
      { k: 'version', name: 'Release', text: `${RELEASE} ist das aktuelle stabile Release.` },
      { k: 'target', name: 'Target', text: 'Wird von der Chip-Plattform bestimmt. Es muss exakt zu Ihrem Gerät passen.' },
      { k: 'profile', name: 'Profile', text: 'Das genaue Modell und manchmal das Flash-Layout.' },
      { k: 'fs', name: 'Dateisystem', text: 'squashfs erlaubt das Zurücksetzen auf Standardwerte; ext4 ist vollständig beschreibbar.' },
      { k: 'type', name: 'Image-Typ', text: 'sysupgrade aktualisiert ein vorhandenes OpenWrt; combined ist ein Image des gesamten Datenträgers, -efi für UEFI.' },
      { k: 'ext', name: 'Dateiendung', text: '.bin / .itb werden unverändert geflasht; .img.gz wird vor dem Schreiben auf den Datenträger entpackt.' },
  ],
  fr: [
      { k: 'version', name: 'Version', text: `${RELEASE} est la version stable actuelle.` },
      { k: 'target', name: 'Target', text: 'Déterminé par la plateforme de la puce. Il doit correspondre exactement à votre appareil.' },
      { k: 'profile', name: 'Profile', text: 'Le modèle exact et, parfois, la disposition de la flash.' },
      { k: 'fs', name: 'Système de fichiers', text: 'squashfs permet le retour aux paramètres par défaut ; ext4 est entièrement accessible en écriture.' },
      { k: 'type', name: 'Type d’image', text: 'sysupgrade met à jour un OpenWrt existant ; combined est une image de disque complet, -efi pour UEFI.' },
      { k: 'ext', name: 'Extension', text: '.bin / .itb se flashent tels quels ; .img.gz est décompressé avant l’écriture sur le disque.' },
  ],
  'zh-hant': [
    { k: 'version', name: '版本', text: `${RELEASE} 是目前的穩定版。` },
    { k: 'target', name: 'target', text: '由晶片平台決定，必須與裝置完全一致。' },
    { k: 'profile', name: 'profile', text: '精確到型號，有時還會區分分區配置。' },
    { k: 'fs', name: '檔案系統', text: 'squashfs 可以還原為預設值；ext4 整體可寫入。' },
    { k: 'type', name: '映像檔類型', text: 'sysupgrade 用於已安裝 OpenWrt 的升級；combined 是含開機載入程式的整碟映像檔，-efi 用於 UEFI。' },
    { k: 'ext', name: '副檔名', text: '.bin／.itb 直接刷入；.img.gz 需先解壓縮再寫入磁碟。' },
  ],
});

const data: HeroData = {
  ...hero,
  eyebrow: pick(l, { en: `OpenWrt ${RELEASE} · released ${RELEASE_DATE}`, zh: `OpenWrt ${RELEASE} · ${RELEASE_DATE} 发布`, 'zh-hant': `OpenWrt ${RELEASE} · ${RELEASE_DATE} 發布`, ja: `OpenWrt ${RELEASE} · ${RELEASE_DATE} リリース`, es: `OpenWrt ${RELEASE} · publicado el ${RELEASE_DATE}`, de: `OpenWrt ${RELEASE} · veröffentlicht am ${RELEASE_DATE}`, fr: `OpenWrt ${RELEASE} · publié le ${RELEASE_DATE}` }),
  stats: pick(l, {
    en: [
        [RELEASE, 'current stable release'],
        [RELEASE_DATE, 'release date'],
        [String(devices.length), 'common devices listed below'],
        ['2026-09', 'end of 24.10 security updates'],
      ],
    zh: [
        [RELEASE, '当前稳定版'],
        [RELEASE_DATE, '发布日期'],
        [String(devices.length), '本页列出的常见设备'],
        ['2026-09', '24.10 安全更新截止'],
      ],
    ja: [
        [RELEASE, '現在の安定版'],
        [RELEASE_DATE, 'リリース日'],
        [String(devices.length), '下に掲載している主要なデバイス'],
        ['2026-09', '24.10 のセキュリティ更新の終了'],
      ],
    es: [
        [RELEASE, 'versión estable actual'],
        [RELEASE_DATE, 'fecha de publicación'],
        [String(devices.length), 'dispositivos habituales listados abajo'],
        ['2026-09', 'fin de las actualizaciones de seguridad de 24.10'],
      ],
    de: [
        [RELEASE, 'aktuelles stabiles Release'],
        [RELEASE_DATE, 'Veröffentlichungsdatum'],
        [String(devices.length), 'gängige Geräte, unten aufgelistet'],
        ['2026-09', 'Ende der Sicherheitsupdates für 24.10'],
      ],
    fr: [
        [RELEASE, 'version stable actuelle'],
        [RELEASE_DATE, 'date de publication'],
        [String(devices.length), 'appareils courants listés ci-dessous'],
        ['2026-09', 'fin des mises à jour de sécurité de 24.10'],
      ],
    'zh-hant': [
        [RELEASE, '目前穩定版'],
        [RELEASE_DATE, '發布日期'],
        [String(devices.length), '本頁列出的常見裝置'],
        ['2026-09', '24.10 安全性更新截止'],
      ],
  }),
};
---

<section class="rh-hero rh-v-download" aria-labelledby="_top">
  <div class="rh-hero-grid" aria-hidden="true" />
  <HeroCopy hero={data} />

  <figure class="fa rh-in rh-in-scale" style="--i:3">
    <div class="fa-head">
      <span class="fa-title">{pick(l, { en: 'Read a firmware filename', zh: '读懂固件文件名', 'zh-hant': '看懂韌體檔名', ja: 'ファームウェアのファイル名の読み方', es: 'Cómo leer el nombre de un archivo de firmware', de: 'Firmware-Dateinamen lesen', fr: 'Lire un nom de fichier de firmware' })}</span>
      <div class="fa-tabs" role="radiogroup" aria-label={pick(l, { en: 'Example', zh: '示例', 'zh-hant': '範例', ja: '例', es: 'Ejemplo', de: 'Beispiel', fr: 'Exemple' })}>
        {examples.map((ex, i) => (
          <label>
            <input type="radio" name="fa-example" value={ex.id} checked={i === 0} />
            <span>{ex.label}</span>
          </label>
        ))}
      </div>
    </div>

    {examples.map((ex) => (
      <p class:list={['fa-name', `fa-ex-${ex.id}`]}>
        {ex.segs.map((s, i) => (
          <><button type="button" class="fa-seg" data-k={s.k}>{s.text}</button>{i < ex.segs.length - 1 && <span class="fa-dash">-</span>}</>
        ))}<button type="button" class="fa-seg" data-k="ext">{ext[ex.id]}</button>
      </p>
    ))}

    <dl class="fa-legend">
      {legend.map((l) => (
        <div data-k={l.k}>
          <dt>{l.name}</dt>
          <dd>{l.text}</dd>
        </div>
      ))}
    </dl>
  </figure>

  <HeroStats hero={data} />
</section>

<style>
  @media (min-width: 64rem) {
    .rh-v-download {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      column-gap: 3.5rem;
      align-items: center;
    }
  }

  .fa {
    margin: 0;
    padding: 1.25rem;
    border: 1px solid var(--rh-line-strong);
    border-radius: 1.4rem;
    background:
      radial-gradient(80% 60% at 70% 0%, color-mix(in srgb, var(--sl-color-accent) 10%, transparent), transparent 70%),
      var(--rh-surface);
    box-shadow: var(--rh-shadow);
  }
  .fa-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
  .fa-title {
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--sl-color-gray-3);
  }
  .fa-tabs {
    display: inline-flex;
    padding: 0.2rem;
    border: 1px solid var(--rh-line);
    border-radius: 999px;
    background: var(--sl-color-bg);
  }
  .fa-tabs label {
    cursor: pointer;
  }
  .fa-tabs input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .fa-tabs span {
    display: block;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 560;
    color: var(--sl-color-gray-3);
    transition: background-color 0.25s, color 0.25s;
  }
  .fa-tabs input:checked + span {
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
  }
  .fa-tabs input:focus-visible + span {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .fa-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    row-gap: 0.4rem;
    margin: 0 0 1.25rem;
    padding: 1rem;
    border-radius: 0.9rem;
    background: var(--rh-code-bg);
    border: 1px solid var(--rh-line);
    font-family: var(--__sl-font-mono);
    font-size: clamp(0.78rem, 0.7rem + 0.3vw, 0.92rem);
  }
  .fa:has(input[value='router']:checked) .fa-ex-x86,
  .fa:has(input[value='x86']:checked) .fa-ex-router {
    display: none;
  }
  .fa-seg {
    padding: 0.25rem 0.45rem;
    border: 1px solid transparent;
    border-radius: 0.4rem;
    color: var(--sl-color-gray-1);
    font: inherit;
    cursor: help;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s, transform 0.3s var(--rh-ease-spring);
  }
  .fa-seg[data-k='project'] {
    color: var(--sl-color-gray-4);
    cursor: default;
  }
  .fa-dash {
    color: var(--sl-color-gray-4);
  }
  .fa-seg[data-k='target'],
  .fa-seg[data-k='profile'] {
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .fa-legend {
    display: grid;
    gap: 0.25rem;
    margin: 0;
  }
  .fa-legend div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.5rem 0.65rem;
    border-radius: 0.55rem;
    transition: background-color 0.2s;
  }
  .fa-legend dt {
    font-family: var(--__sl-font-mono);
    font-size: 0.72rem;
    color: var(--sl-color-gray-3);
    padding-top: 0.1rem;
    transition: color 0.2s;
  }
  .fa-legend dd {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }

  /* Pair a segment with its legend row, from either side. */
  .fa:has([data-k='version']:is(:hover, :focus-visible)) [data-k='version'],
  .fa:has([data-k='target']:is(:hover, :focus-visible)) [data-k='target'],
  .fa:has([data-k='profile']:is(:hover, :focus-visible)) [data-k='profile'],
  .fa:has([data-k='fs']:is(:hover, :focus-visible)) [data-k='fs'],
  .fa:has([data-k='type']:is(:hover, :focus-visible)) [data-k='type'],
  .fa:has([data-k='ext']:is(:hover, :focus-visible)) [data-k='ext'] {
    --on: 1;
  }
  .fa-seg {
    background: color-mix(in srgb, var(--sl-color-accent) calc(var(--on, 0) * 18%), transparent);
    border-color: color-mix(in srgb, var(--sl-color-accent) calc(var(--on, 0) * 100%), transparent);
  }
  .fa-legend div {
    background: color-mix(in srgb, var(--sl-color-accent) calc(var(--on, 0) * 9%), transparent);
  }
  .fa-legend div dt {
    color: color-mix(in srgb, var(--sl-color-accent) calc(var(--on, 0) * 100%), var(--sl-color-gray-3));
  }
  .fa-seg:is(:hover, :focus-visible) {
    transform: translateY(-2px);
    outline: none;
  }
  .fa-seg[data-k='project']:hover {
    transform: none;
  }
</style>
