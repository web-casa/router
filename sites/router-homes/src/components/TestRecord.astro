---
import Icon from './Icon.astro';

interface Props {
  status: 'planned' | 'partial' | 'verified';
  environment?: string;
  recipe?: string;
  result?: string;
  date?: string;
}
const locale = (Astro.locals as any).starlightRoute?.locale ?? 'en';
const isEn = locale === 'en';
const { status, environment = isEn ? 'Not specified' : '未注明', recipe = isEn ? 'Not registered' : '未登记', result, date } = Astro.props;
const labels = isEn
  ? { planned: 'Planned', partial: 'E2 lab reproduced', verified: 'Verified' }
  : { planned: '计划中', partial: 'E2 实验已复现', verified: '已验证' };
const warning = status === 'planned'
  ? (isEn
      ? 'Not tested yet. Run the fixed recipe before promoting this page to E2/E3.'
      : '尚未实测；先按固定配方复现，再标记 E2/E3。')
  : status === 'partial'
    ? (isEn
        ? 'E2 lab reproduced; not independently reviewed or tested on a physical network. E3 still needs real hardware.'
        : '已在固定实验环境完成 E2 复现；未做独立复核或真实物理网络验证，E3 仍需真实设备。')
    : '';
---
<aside id="test-record" class={`test-record test-record-${status}`} aria-label={isEn ? 'Test record' : '测试记录'}>
  <div class="test-head">
    <Icon name="test-tube" />
    <strong>{isEn ? 'Test record' : '测试记录'}</strong>
    <span class="test-status">
      <span class="rh-led" data-state={status === 'verified' ? 'ok' : status === 'partial' ? 'on' : undefined} aria-hidden="true"></span>
      <span class="sr-only">{isEn ? 'Status' : '状态'}: </span>{labels[status]}
    </span>
  </div>
  <dl>
    <dt>{isEn ? 'Environment' : '环境'}</dt><dd>{environment}</dd>
    <dt>{isEn ? 'Recipe' : '配方'}</dt><dd><code>{recipe}</code></dd>
    {date && <><dt>{isEn ? 'Date' : '日期'}</dt><dd>{date}</dd></>}
    {result && <><dt>{isEn ? 'Result' : '结果'}</dt><dd>{result}</dd></>}
  </dl>
  {warning && <p class="test-warning">{warning}</p>}
</aside>
