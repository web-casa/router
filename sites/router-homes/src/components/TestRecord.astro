---
import Icon from './Icon.astro';
import { pick } from '../i18n';

interface Props {
  status: 'planned' | 'partial' | 'verified';
  environment?: string;
  recipe?: string;
  result?: string;
  date?: string;
}
const locale = (Astro.locals as any).starlightRoute?.locale ?? 'en';
const t = pick(locale, {
  en: {
    unspecified: 'Not specified', unregistered: 'Not registered', testRecord: 'Test record', status: 'Status', environment: 'Environment', recipe: 'Recipe', date: 'Date', result: 'Result',
    labels: { planned: 'Planned', partial: 'E2 lab reproduced', verified: 'Verified' },
    planned: 'Not tested yet. Run the fixed recipe before promoting this page to E2/E3.',
    partial: 'E2 lab reproduced; not independently reviewed or tested on a physical network. E3 still needs real hardware.',
  },
  zh: {
    unspecified: '未注明', unregistered: '未登记', testRecord: '测试记录', status: '状态', environment: '环境', recipe: '配方', date: '日期', result: '结果',
    labels: { planned: '计划中', partial: 'E2 实验已复现', verified: '已验证' },
    planned: '尚未实测；先按固定配方复现，再标记 E2/E3。',
    partial: '已在固定实验环境完成 E2 复现；未做独立复核或真实物理网络验证，E3 仍需真实设备。',
  },
  ja: {
    unspecified: '未指定', unregistered: '未登録', testRecord: 'テスト記録', status: '状態', environment: '環境', recipe: '手順', date: '日付', result: '結果',
    labels: { planned: '予定', partial: 'E2 ラボで再現', verified: '検証済み' },
    planned: 'まだテストしていません。このページを E2/E3 に引き上げる前に、定められた手順を実行してください。',
    partial: 'E2 ラボで再現済みです。独立したレビューや物理ネットワークでのテストは行っていません。E3 には実機が必要です。',
  },
  es: {
    unspecified: 'No especificado', unregistered: 'No registrada', testRecord: 'Registro de pruebas', status: 'Estado', environment: 'Entorno', recipe: 'Receta', date: 'Fecha', result: 'Resultado',
    labels: { planned: 'Prevista', partial: 'Reproducido en laboratorio (E2)', verified: 'Verificada' },
    planned: 'Aún sin probar. Ejecute la receta fija antes de promover esta página a E2/E3.',
    partial: 'Reproducido en laboratorio (E2); sin revisión independiente ni prueba en una red física. El E3 sigue necesitando hardware real.',
  },
  de: {
    unspecified: 'Nicht angegeben', unregistered: 'Nicht erfasst', testRecord: 'Testprotokoll', status: 'Status', environment: 'Umgebung', recipe: 'Rezept', date: 'Datum', result: 'Ergebnis',
    labels: { planned: 'Geplant', partial: 'E2 im Labor nachgestellt', verified: 'Verifiziert' },
    planned: 'Noch nicht getestet. Führen Sie das feste Rezept aus, bevor Sie diese Seite auf E2/E3 hochstufen.',
    partial: 'E2 im Labor nachgestellt; nicht unabhängig geprüft und nicht in einem physischen Netzwerk getestet. Für E3 ist weiterhin echte Hardware nötig.',
  },
  fr: {
    unspecified: 'Non précisé', unregistered: 'Non enregistrée', testRecord: 'Journal de test', status: 'Statut', environment: 'Environnement', recipe: 'Recette', date: 'Date', result: 'Résultat',
    labels: { planned: 'Prévu', partial: 'Reproduit en laboratoire (E2)', verified: 'Vérifié' },
    planned: 'Pas encore testé. Exécutez la recette fixe avant de faire passer cette page en E2/E3.',
    partial: 'Reproduit en laboratoire (E2) ; sans relecture indépendante ni test sur un réseau physique. Le niveau E3 exige toujours du matériel réel.',
  },
  'zh-hant': {
    unspecified: '未註明', unregistered: '未登錄', testRecord: '測試紀錄', status: '狀態', environment: '環境', recipe: '配方', date: '日期', result: '結果',
    labels: { planned: '計畫中', partial: 'E2 實驗已重現', verified: '已驗證' },
    planned: '尚未實測；請先依固定配方重現，再標記為 E2/E3。',
    partial: '已在固定實驗環境完成 E2 重現；尚未經過獨立覆核，也未在實體網路上驗證，E3 仍需要實體裝置。',
  },
});
const { status, environment = t.unspecified, recipe = t.unregistered, result, date } = Astro.props;
const labels = t.labels;
const warning = status === 'planned' ? t.planned : status === 'partial' ? t.partial : '';
---
<aside id="test-record" class={`test-record test-record-${status}`} aria-label={t.testRecord}>
  <div class="test-head">
    <Icon name="test-tube" />
    <strong>{t.testRecord}</strong>
    <span class="test-status">
      <span class="rh-led" data-state={status === 'verified' ? 'ok' : status === 'partial' ? 'on' : undefined} aria-hidden="true"></span>
      <span class="sr-only">{t.status}: </span>{labels[status]}
    </span>
  </div>
  <dl>
    <dt>{t.environment}</dt><dd>{environment}</dd>
    <dt>{t.recipe}</dt><dd><code>{recipe}</code></dd>
    {date && <><dt>{t.date}</dt><dd>{date}</dd></>}
    {result && <><dt>{t.result}</dt><dd>{result}</dd></>}
  </dl>
  {warning && <p class="test-warning">{warning}</p>}
</aside>
