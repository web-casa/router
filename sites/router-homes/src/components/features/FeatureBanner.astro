---
// Top-of-page banner for a feature page: the card illustration, framed.
import Icon from '../Icon.astro';
import FeatureVisual from './FeatureVisual.astro';
import { featureBySlug, type FeatureSlug } from './features';

interface Props { slug: FeatureSlug }
const { slug } = Astro.props;
const isEn = ((Astro.locals as any).starlightRoute?.locale ?? 'en') === 'en';
const feature = featureBySlug[slug];
const copy = isEn ? feature.en : feature.zh;
---

<figure class:list={['feature-banner', 'not-content', { 'feature-banner-hero': slug === 'openwrt-25-12' }]}>
  <div class="feature-banner-visual">
    <FeatureVisual slug={slug} isEn={isEn} />
  </div>
  <figcaption>
    <Icon name={feature.icon} />
    <span>{copy.desc}</span>
  </figcaption>
</figure>

<style>
  .feature-banner {
    margin: 0 0 2rem;
    border: 1px solid var(--rh-line);
    border-radius: 1.4rem;
    background:
      radial-gradient(70% 70% at 50% 40%, color-mix(in srgb, var(--sl-color-accent) 9%, transparent), transparent 75%),
      var(--rh-surface);
    overflow: hidden;
  }
  .feature-banner-hero {
    background:
      radial-gradient(70% 70% at 50% 40%, color-mix(in srgb, var(--sl-color-accent) 16%, transparent), transparent 75%),
      linear-gradient(160deg, var(--sl-color-accent-low), var(--rh-surface) 70%);
  }
  .feature-banner-visual {
    display: grid;
    place-items: center;
    min-height: 15rem;
    padding: 2rem 1.5rem;
  }
  .feature-banner figcaption {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.25rem;
    border-top: 1px solid var(--rh-line);
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
  }
  .feature-banner figcaption :global(.i) {
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--sl-color-accent);
  }
</style>
